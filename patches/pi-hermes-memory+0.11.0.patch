     // removes indexes attached to the old memories table.
     this.ensureMemoryIndexes(db);
     this.migrateFtsTokenizer(db);
+    const projectionKey = 'aide.input-projection.v1';
+    if (!db.prepare('SELECT 1 FROM extension_metadata WHERE key = ?').get(projectionKey)) {
+      db.exec('BEGIN IMMEDIATE');
+      try {
+        const inserted = db.prepare("INSERT OR IGNORE INTO extension_metadata (key, value) VALUES (?, '1')").run(projectionKey);
+        // Existing size/mtime receipts predate Input indexing. Keep retention timestamps and searchable rows.
+        if (inserted.changes) db.exec('UPDATE session_files SET size = -1');
+        db.exec('COMMIT');
+      } catch (error) {
+        db.exec('ROLLBACK');
+        throw error;
+      }
+    }
   }
 
   private hasExistingMainDatabaseFile(): boolean {
