diff --git a/node_modules/pi-hermes-memory/src/input-projection.ts b/node_modules/pi-hermes-memory/src/input-projection.ts
new file mode 100644
index 0000000..dbcc68e
--- /dev/null
+++ b/node_modules/pi-hermes-memory/src/input-projection.ts
@@ -0,0 +1,19 @@
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import { convertToLlm, type CustomMessageEntry } from "@earendil-works/pi-coding-agent";
+
+/** Project only Personal Inputs. Other extension messages keep their own role. */
+export function memoryMessage(message: AgentMessage) {
+  return message.role === "custom" && message.customType === "aide.input"
+    ? convertToLlm([message])[0]!
+    : message;
+}
+
+/** JSONL entries and session-manager snapshots have the same persisted shape. */
+export function memoryEntry(value: unknown): unknown {
+  const entry = value as Partial<CustomMessageEntry> | null;
+  if (entry?.type !== "custom_message" || entry.customType !== "aide.input" ||
+      typeof entry.timestamp !== "string" || (typeof entry.content !== "string" && !Array.isArray(entry.content))) return value;
+  const message = memoryMessage({ role: "custom", customType: entry.customType, display: entry.display === true,
+    content: entry.content, timestamp: Date.parse(entry.timestamp) });
+  return { type: "message", id: entry.id, parentId: entry.parentId, timestamp: entry.timestamp, message };
+}
